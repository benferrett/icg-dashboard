# Inner Circle Group Dashboard — environment variables
# Copy to .env locally, or set these in Railway → Variables.

# HubSpot Private App access token (starts with "pat-...").
# Needs scopes: crm.objects.deals.read  (and optionally crm.objects.owners.read
# for live owner names — without it, names fall back to the baked-in map).
HUBSPOT_TOKEN=

# Meta (Facebook) Marketing API access token.
# Generate a long-lived / system-user token so it doesn't expire.
# Needs: ads_read on the ad account(s). Leave blank to hide the Meta section.
META_TOKEN=

# Password users type on the dashboard login screen.
DASHBOARD_PASSWORD=InnerCircle2026$$

# Port the server listens on. Railway sets this automatically; default 5000 locally.
PORT=5000

# Xero API — for Accounts Receivable tab
# Create a Xero Custom Connection at developer.xero.com → your app →
# Configuration → generate Client ID + Secret; then use OAuth2 client-credentials
# flow to get a refresh token. Requires scopes: accounting.transactions.read,
# accounting.contacts.read.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REFRESH_TOKEN=

# Gmail send-as for accounts@innercirclegroup.com.au — for AR follow-up emails
# Uses OAuth2 refresh token flow. Create OAuth client in your ICG Google Cloud
# project (type: Web application), then authorise once as accounts@ to get the
# refresh token. Requires scope: https://www.googleapis.com/auth/gmail.send
GMAIL_ACCOUNTS_CLIENT_ID=
GMAIL_ACCOUNTS_CLIENT_SECRET=
GMAIL_ACCOUNTS_REFRESH_TOKEN=
